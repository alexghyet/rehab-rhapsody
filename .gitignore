# Operating system files
.DS_Store
._*
Thumbs.db
desktop.ini

# Editors
*.swp
*.iml
*.ipr
*.iws
.idea/
.atom/
.history/
# VS Code: share the recommended extensions and launch configs, but keep
# everyone's personal settings local.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Local environment values; share placeholder-only examples.
.env
.env.*
!.env.example
!.env.*.example

# Signing credentials and private keys
*.p8
*.p12
*.pfx
*.key
*.mobileprovision
*.provisionprofile

# Flutter/Dart/Pub build output and caches
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
.widget_preview/
migrate_working_dir/
# Keep pubspec.lock and .metadata tracked for reproducible app setup.

# iOS caches and user state (additional generated files: ios/.gitignore)
**/ios/Flutter/.last_build_id
.swiftpm/
**/DerivedData/
**/xcuserdata/
*.xcuserstate
# Keep native dependency lockfiles (Podfile.lock / Package.resolved) tracked.

# Release symbols and obfuscation maps
app.*.symbols
app.*.map.json

# Miscellaneous
*.class
*.log
*.pyc
__pycache__/
node_modules/
# Arduino dependencies are installed locally, not vendored into this app.
/firmware/libraries/
.build/
.buildlog/
.svn/
